import os
import json
import re
import requests
import pandas as pd
from bs4 import BeautifulSoup
import urllib3
from datetime import datetime

# 禁用安全警告（针对阿里内网环境常见证书问题）
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)


def get_desktop_path():
    """获取当前用户的桌面路径，优先检测 OneDrive 桌面"""
    user_home = os.path.expanduser("~")
    candidates = [
        os.path.join(user_home, "OneDrive", "桌面"),
        os.path.join(user_home, "OneDrive", "Desktop"),
        os.path.join(user_home, "Desktop"),
        os.path.join(user_home, "桌面")
    ]
    for path in candidates:
        if os.path.exists(path):
            return path
    return os.path.join(user_home, "Desktop")


DESKTOP_PATH = get_desktop_path()


# ==========================================
# 任务一：AE 报销邮件同步
# ==========================================
def run_email_sync_task():
    save_dir = os.path.join(DESKTOP_PATH, "测试文件夹")
    if not os.path.exists(save_dir):
        os.makedirs(save_dir, exist_ok=True)

    FETCH_LIMIT = 20  # <--- 在这里设置你想要的总数，比如 200
    PAGE_SIZE = 50    # 每页取多少，建议不要超过 100
    TASKS = {
        "101": "LAX-AE.xlsx",
        "102": "ORD-AE.xlsx",
        "106": "MIA-AE.xlsx"
    }

    DIST_MAP = {
        "MAERSK-末端配送": "Maersk",
        "美国统包标准配送资源": "COE",
        "美国USPS直连末端配送": "USPS",
        "SpeedX配送": "Speedx",
        "UNIUNI末端配送": "UNIUNI"
    }

    def get_auth():
        user_home = os.path.expanduser("~")
        possible_paths = [
            os.path.join(user_home, "Desktop", "emailtoken.txt"),
            os.path.join(user_home, "OneDrive", "桌面", "emailtoken.txt")
        ]
        token_path = next((p for p in possible_paths if os.path.exists(p)), None)
        if not token_path: return None, None
        try:
            with open(token_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
                return data.get("cookies", {}), data.get("xsrf_token", None)
        except Exception as e:
            print(f"❌ 无法读取 Token 文件: {e}")
            return None, None

    cookies, xsrf_token = get_auth()
    if not xsrf_token:
        print("❌ AE任务：未找到有效的 emailtoken.txt")
        return

    session = requests.Session()
    session.cookies.update(cookies)
    headers = {"User-Agent": "Mozilla/5.0", "Content-Type": "application/x-www-form-urlencoded"}

    def parse_mail_body(html_body):
        soup = BeautifulSoup(html_body, "html.parser")
        num_re = re.compile(r'[\d,]+\.?\d*')
        eta_re = re.compile(r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}(?::\d{2})?)')

        res = {
            "MAWB": "-", "FLT": "-", "ETA": "-", "T_CTN": 0, "T_PAR": 0, "T_WGT": "-",
            "COE_PAR": "-",
            "W": {k: "-" for k in DIST_MAP.values()},
            "Q": {k: "-" for k in DIST_MAP.values()}
        }

        tables = soup.find_all("table", align="center")
        if not tables: return res

        # --- 修改点 1：从第一个表格获取所有总计字段 ---
        for row in tables[0].find_all("tr"):
            tds = row.find_all("td")
            if len(tds) < 2: continue
            k, v = tds[0].get_text(strip=True), tds[1].get_text(strip=True)
            if "MAWB No." in k:
                res["MAWB"] = v
            elif "Flight Number" in k:
                res["FLT"] = v
            elif "ETA" in k:
                m = eta_re.search(v)
                res["ETA"] = m.group(1) if m else v
            elif "Gross Weight" in k:
                m = num_re.search(v.replace(',', ''))
                res["T_WGT"] = m.group(0) if m else v
            elif "Number of CTN" in k: # 新增：获取总箱数 (如 83CTNs/BAGs -> 83)
                m = num_re.search(v.replace(',', ''))
                res["T_CTN"] = float(m.group(0)) if m else 0
            elif "Quantity of parcels" in k: # 新增：获取总包裹数 (如 4816)
                m = num_re.search(v.replace(',', ''))
                res["T_PAR"] = float(m.group(0)) if m else 0

        # --- 修改点 2：分拨商表格仅用于获取分拨明细，不再进行累加 ---
        for table in tables:
            h = table.find("td", class_="distributorName")
            if h:
                dist_name = h.get_text(strip=True)
                if dist_name in DIST_MAP:
                    col = DIST_MAP[dist_name]
                    for row in table.find_all("tr"):
                        tds = row.find_all("td")
                        if len(tds) < 2: continue
                        label = tds[0].get_text(strip=True)
                        val_raw = tds[1].get_text(strip=True).replace(',', '')
                        m = num_re.search(val_raw)
                        val = float(m.group(0)) if m else 0

                        if "美国统包标准配送资源" in dist_name and "Quantity of parcels" in label:
                            res["COE_PAR"] = int(val) if val > 0 else "-"

                        if "Gross Weight" in label:
                            res["W"][col] = val if val > 0 else "-"
                        elif "Number of CTN" in label:
                            res["Q"][col] = int(val) if val > 0 else "-"
                        # 注意：这里删除了 res["T_CTN"] += val 和 res["T_PAR"] += val
        return res

    for fid, fname in TASKS.items():
        print(f"\n🚀 开始处理 AE 目录 {fid} -> {fname} (目标: {FETCH_LIMIT} 封)")
        all_mails = []

        # --- 分页拉取逻辑开始 ---
        for offset in range(0, FETCH_LIMIT, PAGE_SIZE):
            list_url = "https://mail.alibaba-inc.com/alimail/ajax/mail/queryMailList.txt"
            payload = {
                "query": f'{{"folderIds":["{fid}"]}}',
                "showFrom": "1",
                "offset": str(offset),
                "length": str(PAGE_SIZE),
                "_tpl_": "v5ForWebDing",
                "_csrf_token_": xsrf_token
            }
            try:
                r = session.post(list_url, data=payload, headers=headers, verify=False)
                text = r.text
                if text.startswith("/**/"): text = re.search(r'\((.*)\)', text, re.DOTALL).group(1)
                batch = json.loads(text).get("dataList", [])
                if not batch: break  # 如果没数据了，跳出循环
                all_mails.extend(batch)
                print(f"  已获取列表: {len(all_mails)}/{FETCH_LIMIT}")
            except Exception as e:
                print(f"  ❌ 分页获取失败: {e}")
                break

        all_mails = all_mails[:FETCH_LIMIT]  # 截取需要的数量
        all_mails.reverse()  # 翻转，让旧邮件先处理，新邮件后覆盖

        results = []
        for m in all_mails:
            mid = m.get("mailId")
            load_url = "https://mail.alibaba-inc.com/alimail/ajax/mail/loadMail.txt"
            try:
                res_json = session.post(load_url, data={"mailId": mid, "full": "1", "_tpl_": "v5ForWebDing",
                                                        "_csrf_token_": xsrf_token}, headers=headers,
                                        verify=False).json()
                if res_json.get("status") in [0, 6]:
                    info = parse_mail_body(res_json["data"]["body"])

                    # 修复点 2: 安全转换数值，防止 int("-") 报错
                    try:
                        t_ctn = int(float(info["T_CTN"]))
                    except:
                        t_ctn = 0
                    try:
                        t_par = int(float(info["T_PAR"]))
                    except:
                        t_par = 0

                    results.append({
                        "主单": info["MAWB"], "航班号": info["FLT"], "ETA": info["ETA"],
                        "总箱数": t_ctn, "总包裹数": t_par, "总重量": info["T_WGT"],
                        "Maersk 重量": info["W"]["Maersk"], "COE 重量": info["W"]["COE"],
                        "USPS 重量": info["W"]["USPS"],
                        "Speedx重量": info["W"]["Speedx"], "UNIUNI 重量": info["W"]["UNIUNI"],
                        "Maersk 大箱数": info["Q"]["Maersk"], "COE 大箱数": info["Q"]["COE"],
                        "USPS 大箱数": info["Q"]["USPS"],
                        "Speedx大箱数": info["Q"]["Speedx"], "UNIUNI 大箱数": info["Q"]["UNIUNI"],
                        "COE包裹数": info["COE_PAR"]
                    })
            except:
                pass

        if results:
            new_df = pd.DataFrame(results)
            file_path = os.path.join(save_dir, fname)

            if os.path.exists(file_path):
                old_df = pd.read_excel(file_path)
                combined_df = pd.concat([old_df, new_df], ignore_index=True, sort=False)
            else:
                combined_df = new_df

            # 以主单去重
            final_df = combined_df.drop_duplicates(subset=["主单"], keep="last")

            # --- 动态分组排序逻辑 ---
            all_cols = final_df.columns.tolist()
            # 1. 基础信息列
            base_cols = ["主单", "航班号", "ETA", "总箱数", "总包裹数", "总重量"]
            # 2. 提取所有包含“重量”但不是“总重量”的列，并排序
            weight_cols = sorted([c for c in all_cols if "重量" in c and c != "总重量"])
            # 3. 提取所有包含“大箱数”的列，并排序
            ctn_cols = sorted([c for c in all_cols if "大箱数" in c])
            # 4. 其他列（如 COE包裹数 等）
            other_cols = [c for c in all_cols if c not in base_cols + weight_cols + ctn_cols]

            # 组合新顺序：基础信息 + 所有渠道重量 + 所有渠道箱数 + 其他
            sorted_cols = base_cols + weight_cols + ctn_cols + other_cols
            # 过滤掉可能不存在的列名
            sorted_cols = [c for c in sorted_cols if c in all_cols]

            final_df[sorted_cols].fillna("-").to_excel(file_path, index=False)
            print(f"  ✅ AE {fname} 已动态更新排序")

