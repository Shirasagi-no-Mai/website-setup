def run_4px_sync_task():
    save_dir = os.path.join(DESKTOP_PATH, "测试文件夹")
    if not os.path.exists(save_dir): os.makedirs(save_dir, exist_ok=True)

    TASKS = {"104": "LAX-4PX.xlsx", "108": "ORD-4PX.xlsx", "107": "MIA-4PX.xlsx"}
    CHANNEL_ORDER = [
        "COE/UP", "GOFO", "SPX", "TOO", "USPS", "YW EXP", "DHL", "ACI", "FEDEX", "IB", "UNIUNI", "OC UNIUNI",
        "ATL-GOFO", "ATL-USPS", "ATL-ACI", "ATL-DHL", "SWIFTX"
    ]
    EXACT_MATCH_TO_STD = {"GOFO": "GOFO", "TOOEXPRESS": "TOO", "TOOEXPRESS-DF": "TOO", "UNIUNI": "UNIUNI",
                          "OC-UNI": "OC UNIUNI", "DHL": "DHL", "IB": "IB", "SPX": "SPX", "ACI": "ACI",
                          "FEDEX GROUND": "FEDEX", "USPS-GA": "USPS", "COE": "COE/UP", "YW EXPRESS": "YW EXP","SWIFTX": "SWIFTX",
                          "YW EXP": "YW EXP", "ATL-GOFO": "ATL-GOFO", "ATL-USPS": "ATL-USPS", "ATL-ACI": "ATL-ACI",
                          "ATL-DHL": "ATL-DHL"}

    def get_auth():
        user_home = os.path.expanduser("~")
        possible_paths = [os.path.join(user_home, "Desktop", "emailtoken.txt"),
                          os.path.join(user_home, "OneDrive", "桌面", "emailtoken.txt")]
        token_path = next((p for p in possible_paths if os.path.exists(p)), None)
        if not token_path: return None, None
        try:
            with open(token_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
                return data.get("cookies", {}), data.get("xsrf_token", None)
        except:
            return None, None

    cookies, xsrf_token = get_auth()
    if not xsrf_token: return

    session = requests.Session()
    session.cookies.update(cookies)
    headers = {"User-Agent": "Mozilla/5.0", "Content-Type": "application/x-www-form-urlencoded"}

    def parse_mail_body(html_body):
        soup = BeautifulSoup(html_body, "html.parser")
        num_re = re.compile(r'[\d,]+\.?\d*')
        res = {"MAWB": "-", "FLT": "-", "ETA": "-", "T_WGT": "-", "T_PAR": "-", "T_CTN": "-",
               "W": {k: "-" for k in CHANNEL_ORDER}, "Q": {k: "-" for k in CHANNEL_ORDER}}

        tables = soup.find_all("table", align="center")
        if tables:
            for row in tables[0].find_all("tr"):
                tds = row.find_all("td")
                if len(tds) < 2: continue
                k, v = tds[0].get_text(strip=True), tds[1].get_text(strip=True)
                if "MAWB No." in k:
                    res["MAWB"] = v
                elif "Flight Number" in k:
                    res["FLT"] = v
                elif "ETA" in k:
                    res["ETA"] = v
                elif "Gross Weight" in k:
                    m = num_re.search(v.replace(',', ''))
                    res["T_WGT"] = m.group(0) if m else v
                elif "Quantity of parcels" in k:
                    m = num_re.search(v.replace(',', ''))
                    res["T_PAR"] = m.group(0) if m else v
                elif "Number of CTN" in k:
                    m = num_re.search(v.replace(',', ''))
                    res["T_CTN"] = m.group(0) if m else v

        all_tables = soup.find_all("table")
        for table in all_tables:
            for row in table.find_all("tr"):
                tds = row.find_all("td")
                if len(tds) < 4: continue
                channel_raw = tds[0].get_text(strip=True)
                if channel_raw in EXACT_MATCH_TO_STD:
                    std_name = EXACT_MATCH_TO_STD[channel_raw]
                    try:
                        ctn_val = num_re.search(tds[1].get_text(strip=True).replace(',', '')).group(0)
                        wgt_val = num_re.search(tds[3].get_text(strip=True).replace(',', '')).group(0)
                        res["Q"][std_name] = ctn_val
                        res["W"][std_name] = wgt_val
                    except:
                        pass
        return res

    for fid, fname in TASKS.items():
        print(f"🚀 处理 4PX 目录 {fid} -> {fname}")
        list_url = "https://mail.alibaba-inc.com/alimail/ajax/mail/queryMailList.txt"
        payload = {"query": f'{{"folderIds":["{fid}"]}}', "showFrom": "1", "offset": "0", "length": "20",
                   "_tpl_": "v5ForWebDing", "_csrf_token_": xsrf_token}
        try:
            r = session.post(list_url, data=payload, headers=headers, verify=False)
            text = r.text
            if text.startswith("/**/"): text = re.search(r'\((.*)\)', text, re.DOTALL).group(1)
            mails = json.loads(text).get("dataList", [])
            mails.reverse()
        except:
            continue

        new_results = []
        for m in mails:
            mid = m.get("mailId")
            load_url = "https://mail.alibaba-inc.com/alimail/ajax/mail/loadMail.txt"
            try:
                mail_json = session.post(load_url, data={"mailId": mid, "full": "1", "_tpl_": "v5ForWebDing",
                                                         "_csrf_token_": xsrf_token}, headers=headers,
                                         verify=False).json()
                if mail_json.get("status") in [0, 6]:
                    info = parse_mail_body(mail_json["data"]["body"])
                    row_data = {"MAWB": info["MAWB"], "Flight Number": info["FLT"], "ETA": info["ETA"],
                                "Weight": info["T_WGT"], "Total Parcels": info["T_PAR"], "Total CTN": info["T_CTN"]}
                    for ch in CHANNEL_ORDER: row_data[f"{ch} Weight"] = info["W"][ch]
                    for ch in CHANNEL_ORDER: row_data[f"{ch} CTN"] = info["Q"][ch]
                    new_results.append(row_data)
            except:
                continue

        if new_results:
            new_df = pd.DataFrame(new_results)
            file_path = os.path.join(save_dir, fname)

            if os.path.exists(file_path):
                old_df = pd.read_excel(file_path)
                combined_df = pd.concat([old_df, new_df], ignore_index=True, sort=False)
            else:
                combined_df = new_df

            final_df = combined_df.drop_duplicates(subset=["MAWB"], keep="last")

            # --- 动态分组排序逻辑 ---
            all_cols = final_df.columns.tolist()
            # 1. 基础信息头 (注意 Weight 是总重)
            header = ["MAWB", "Flight Number", "ETA", "Weight", "Total Parcels", "Total CTN"]
            # 2. 渠道重量列 (匹配包含 Weight 但不是总重 Weight 的列)
            chan_weight = sorted([c for c in all_cols if "Weight" in c and c != "Weight"])
            # 3. 渠道箱数列 (匹配包含 CTN 但不是总箱数 Total CTN 的列)
            chan_ctn = sorted([c for c in all_cols if "CTN" in c and c != "Total CTN"])
            # 4. 剩余列
            others = [c for c in all_cols if c not in header + chan_weight + chan_ctn]

            sorted_cols = header + chan_weight + chan_ctn + others
            sorted_cols = [c for c in sorted_cols if c in all_cols]

            final_df[sorted_cols].fillna("-").to_excel(file_path, index=False)
            print(f"  ✅ 4PX {fname} 已动态更新排序")

def run_bdt_sync_task():
    save_dir = os.path.join(DESKTOP_PATH, "测试文件夹")
    if not os.path.exists(save_dir): os.makedirs(save_dir, exist_ok=True)

    # 保持与 4PX 一致的列名和渠道顺序
    CHANNEL_ORDER = [
        "COE/UP", "GOFO", "SPX", "TOO", "USPS", "YW EXP", "DHL", "ACI", "FEDEX", "IB", "UNIUNI", "OC UNIUNI",
        "ATL-GOFO", "ATL-USPS", "ATL-ACI", "ATL-DHL", "SWIFTX"
    ]
    # BDT 渠道映射到标准列名
    BDT_MAP = {"FEDEX": "FEDEX", "GOFO": "GOFO", "USPS": "USPS", "SPX": "SPX", "SWIFTX": "SWIFTX"}

    def get_auth():
        user_home = os.path.expanduser("~")
        token_path = next((p for p in [os.path.join(user_home, "Desktop", "emailtoken.txt"),
                                       os.path.join(user_home, "OneDrive", "桌面", "emailtoken.txt")] if
                           os.path.exists(p)), None)
        if not token_path: return None, None
        with open(token_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
            return data.get("cookies", {}), data.get("xsrf_token", None)

    cookies, xsrf_token = get_auth()
    if not xsrf_token: return

    session = requests.Session()
    session.cookies.update(cookies)
    headers = {"User-Agent": "Mozilla/5.0", "Content-Type": "application/x-www-form-urlencoded"}

    def parse_bdt_body(html_body, subject):
        soup = BeautifulSoup(html_body, "html.parser")
        text_content = soup.get_text()

        # 1. 提取口岸
        port = "UNKNOWN"
        port_match = re.search(r'-(LAX|ORD|MIA|JFK)', subject)
        if port_match: port = port_match.group(1)

        res = {"MAWB": "-", "FLT": "-", "ETA": "-", "T_WGT": "-", "T_PAR": "-", "T_CTN": "-",
               "W": {k: "-" for k in CHANNEL_ORDER}, "Q": {k: "-" for k in CHANNEL_ORDER}, "PORT": port}

        # --- 基础字段提取 ---
        res["MAWB"] = (re.search(r"MAWB[:：]\s*([\d-]+)", text_content, re.I) or re.search(r"", "")).group(
            1) if re.search(r"MAWB[:：]\s*([\d-]+)", text_content, re.I) else "-"
        res["T_CTN"] = (re.search(r"Shipping Units:\s*<([\d.]+)>", text_content) or re.search(r"", "")).group(
            1) if re.search(r"Shipping Units:\s*<([\d.]+)>", text_content) else "-"
        res["T_PAR"] = (re.search(r"Pieces:\s*<([\d.]+)>", text_content) or re.search(r"", "")).group(1) if re.search(
            r"Pieces:\s*<([\d.]+)>", text_content) else "-"
        res["T_WGT"] = (re.search(r"Weight:\s*<([\d.]+)>", text_content) or re.search(r"", "")).group(1) if re.search(
            r"Weight:\s*<([\d.]+)>", text_content) else "-"
        res["FLT"] = (re.search(r"Flight Number[:：]\s*(\w+)", text_content, re.I) or re.search(r"", "")).group(
            1) if re.search(r"Flight Number[:：]\s*(\w+)", text_content, re.I) else "-"

        # --- ETA 提取与格式化 (核心修改点) ---
        eta_raw = "-"
        eta_m = re.search(r"ETA\s+\w+[:：]\s*(.*?)(?=\s*\d\.|\r|\n|$)", text_content, re.I | re.DOTALL)
        if eta_m:
            eta_raw = eta_m.group(1).strip()
            try:
                # 1. 彻底清除括号内容 (如 Local time) 和全角冒号
                clean_eta = re.sub(r'\(.*?\)', '', eta_raw).replace("：", ":").strip()

                # 2. 修复残缺年份 (202/5/26 -> 2025/5/26)
                clean_eta = re.sub(r'^202([/\-])', r'2025\1', clean_eta)

                # 3. 检查是否缺少 4 位数的年份 (针对 29 May 18:55 这种情况)
                if not re.search(r'\d{4}', clean_eta):
                    # 获取今年年份 (如 2025) 补在字符串后面
                    curr_year = str(pd.Timestamp.now().year)
                    clean_eta = f"{clean_eta} {curr_year}"

                # 4. 使用 Pandas 解析
                # dayfirst=True 帮助解析类似 29 May 的格式
                dt = pd.to_datetime(clean_eta, errors='coerce', dayfirst=True)

                if pd.notna(dt):
                    # 格式化输出
                    res["ETA"] = dt.strftime('%Y-%m-%d %H:%M')
                else:
                    res["ETA"] = eta_raw  # 还是不行就保底
            except:
                res["ETA"] = eta_raw
        else:
            res["ETA"] = "-"

        # --- 提取表格数据 (保持不变) ---
        for table in soup.find_all("table"):
            rows = table.find_all("tr")
            for row in rows:
                tds = [t.get_text(strip=True) for t in row.find_all("td")]
                if len(tds) >= 4 and tds[1] in BDT_MAP:
                    std_name = BDT_MAP[tds[1]]
                    res["W"][std_name] = tds[2]
                    res["Q"][std_name] = tds[3]
        return res

    print(f"🚀 开始处理 BDT 目录 110")
    list_url = "https://mail.alibaba-inc.com/alimail/ajax/mail/queryMailList.txt"
    payload = {"query": '{"folderIds":["110"]}', "offset": "0", "length": "80", "_tpl_": "v5ForWebDing",
               "_csrf_token_": xsrf_token}

    try:
        r = session.post(list_url, data=payload, headers=headers, verify=False)
        text = r.text
        if text.startswith("/**/"): text = re.search(r'\((.*)\)', text, re.DOTALL).group(1)
        mails = json.loads(text).get("dataList", [])
        mails.reverse()
    except:
        return

    # 按口岸分组合并数据
    port_results = {}
    for m in mails:
        mid, sub = m.get("mailId"), m.get("subject")
        load_url = "https://mail.alibaba-inc.com/alimail/ajax/mail/loadMail.txt"
        try:
            mj = session.post(load_url,
                              data={"mailId": mid, "full": "1", "_tpl_": "v5ForWebDing", "_csrf_token_": xsrf_token},
                              headers=headers, verify=False).json()
            if mj.get("status") in [0, 6]:
                info = parse_bdt_body(mj["data"]["body"], sub)
                p = info["PORT"]
                if p not in port_results: port_results[p] = []

                row_data = {"MAWB": info["MAWB"], "Flight Number": info["FLT"], "ETA": info["ETA"],
                            "Weight": info["T_WGT"], "Total Parcels": info["T_PAR"], "Total CTN": info["T_CTN"]}
                for ch in CHANNEL_ORDER: row_data[f"{ch} Weight"] = info["W"][ch]
                for ch in CHANNEL_ORDER: row_data[f"{ch} CTN"] = info["Q"][ch]
                port_results[p].append(row_data)
        except:
            continue

    # 保存到对应的口岸文件
    for p, results in port_results.items():
        if p == "UNKNOWN": continue
        fname = f"{p}-BDT.xlsx"
        new_df = pd.DataFrame(results)
        file_path = os.path.join(save_dir, fname)

        if os.path.exists(file_path):
            old_df = pd.read_excel(file_path)
            combined_df = pd.concat([old_df, new_df], ignore_index=True, sort=False)
        else:
            combined_df = new_df

        final_df = combined_df.drop_duplicates(subset=["MAWB"], keep="last")

        # --- 动态分组排序逻辑 ---
        all_cols = final_df.columns.tolist()
        header = ["MAWB", "Flight Number", "ETA", "Weight", "Total Parcels", "Total CTN"]
        chan_weight = sorted([c for c in all_cols if "Weight" in c and c != "Weight"])
        chan_ctn = sorted([c for c in all_cols if "CTN" in c and c != "Total CTN"])
        others = [c for c in all_cols if c not in header + chan_weight + chan_ctn]

        sorted_cols = [c for c in (header + chan_weight + chan_ctn + others) if c in all_cols]

        final_df[sorted_cols].fillna("-").to_excel(file_path, index=False)
        print(f"  ✅ BDT {fname} 已动态更新排序")


